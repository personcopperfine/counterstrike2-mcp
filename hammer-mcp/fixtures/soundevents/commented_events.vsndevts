{
	// a comment BETWEEN events (before alpha)
	"alpha.event" = 
	{
		type = "csgo_mega"
		volume = 0.5
		// a comment INSIDE alpha.event
		pitch = 1.0
	}
	/* a block comment
	   spanning two lines, between events */
	"beta.event" = 
	{
		base = "alpha.event"
		// a comment INSIDE beta.event
		volume = 0.2
	}
	// a trailing comment after the last event
}