+
+	VMatrix		m_unk201;
+	VMatrix		m_unk202;
+	VMatrix		m_unk203;
+	VMatrix		m_unk204;
+
+	float		m_unk205;
+	float		m_unk206;
+	float		m_unk207;
+	float		m_unk208;
+	float		m_unk209;
 };
 
 #endif // CAMERA_H
