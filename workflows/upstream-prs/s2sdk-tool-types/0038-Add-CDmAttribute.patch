From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Sun, 18 Oct 2026 12:10:57 -0500
Subject: [PATCH 38/47] Add CDmAttribute

Member names follow Source SDK 2013 public/datamodel/dmattribute.h. Verified
against CS2 2000930 (win64).
---
 public/datamodel/dmattribute.h | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)
 create mode 100644 public/datamodel/dmattribute.h

diff --git a/public/datamodel/dmattribute.h b/public/datamodel/dmattribute.h
new file mode 100644
index 00000000..e8aec87b
--- /dev/null
+++ b/public/datamodel/dmattribute.h
@@ -0,0 +1,33 @@
+//===== Copyright (c) 1996-2005, Valve Corporation, All rights reserved. ======//
+//
+// Purpose: An attribute of an element of the datamodel
+//
+//===========================================================================//
+
+#ifndef DMATTRIBUTE_H
+#define DMATTRIBUTE_H
+#ifdef _WIN32
+#pragma once
+#endif
+
+#include "datamodel/idatamodel.h"
+#include "tier0/utlsymbollarge.h"
+#include "tier0/platform.h"
+
+class CDmElement;
+
+// AMNOTE: Incomplete class, only the members are known (no virtual functions)
+class CDmAttribute
+{
+public:
+	// AMNOTE: The next attribute of m_pOwner (the list starts at CDmElement::m_pAttributes)
+	CDmAttribute *m_pNext;
+	void *m_pData;
+	CDmElement *m_pOwner;
+	DmAttributeHandle_t m_Handle;
+	// AMNOTE: The low 6 bits are the DmAttributeType_t
+	uint32 m_nFlags;
+	CUtlSymbolLarge m_Name;
+};
+
+#endif // DMATTRIBUTE_H
