# Build image for Metamod:Source 2.0-dev against the cs2 SDK (linux + win64 cross).
#
# The base is the exact image upstream CI uses for the Linux half of
# .github/workflows/build-release.yml (ghcr.io/alliedmodders/build-containers/debian11-clang22).
# Upstream gets AMBuild from support/checkout-deps.sh (a `git clone` of
# alliedmodders/ambuild master); we clone the same repo but at a pinned commit and install it
# into the image, so a build only needs this one image and the mounted dependency cache.
#
# Build (done automatically by build-metamod.sh when the tag is missing):
#   podman build -t localhost/mmsource-build:debian11-clang22 bridge/metamod
FROM ghcr.io/alliedmodders/build-containers/debian11-clang22:latest

# Pinned alliedmodders/ambuild commit (master, 2026-10-19). Bump: change the hash, rebuild.
ARG AMBUILD_COMMIT=01212cb57c96561f664b6dfb2ee10e66de6f81e4

RUN set -eux; \
    git clone --quiet https://github.com/alliedmodders/ambuild /opt/ambuild; \
    git -C /opt/ambuild checkout --quiet "$AMBUILD_COMMIT"; \
    git -C /opt/ambuild rev-parse HEAD > /opt/ambuild-commit.txt; \
    python3 -m pip install --no-cache-dir /opt/ambuild; \
    python3 -c "import ambuild2, sys; print('ambuild2 import ok on', sys.version)"
